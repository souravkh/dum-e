
{
  "manifest_version": 3,
  "name": "SIL-Y",
  "version": "1.0.0",
  "description": "A lightweight GP test timing and results tracker.",
  "permissions": [
    "sidePanel"
  ],
  "icons": {
    "16": "icons/sil-y16.png",
    "32": "icons/sil-y32.png",
    "48": "icons/sil-y48.png",
    "128": "icons/sil-y128.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "SIL-Y",
    "default_icon": {
      "16": "icons/sil-y16.png",
      "32": "icons/sil-y32.png"
    }
  }
}
